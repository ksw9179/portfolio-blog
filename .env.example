# Supabase 프로젝트 설정 → API에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub API용 개인 액세스 토큰(PAT). 읽기 전용 최소 권한으로 발급할 것.
# 발급: https://github.com/settings/tokens → Generate new token (classic)
# 권한(scope): public_repo, read:user 만 체크
# 실제 값은 .env.local에 넣을 것 (커밋되지 않음)
GITHUB_TOKEN=
